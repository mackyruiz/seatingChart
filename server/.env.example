# Copy this file to .env and fill in real values before running in anything but local dev.

# Secret used to sign auth session tokens. MUST be a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on.
PORT=4000

# Origin the frontend is served from (for CORS + cookie settings).
CLIENT_ORIGIN=http://localhost:5173

# Set to "true" once served over HTTPS in production so auth cookies get Secure+SameSite=strict.
COOKIE_SECURE=false

# Path to the SQLite database file.
DATABASE_FILE=./data/seating.db

# Directory where uploaded floor plan images are stored (kept outside any web/exec path).
UPLOADS_DIR=./uploads

# Bootstrap owner account created by `npm run seed` if no users exist yet.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-now
SEED_OWNER_NAME=Site Owner
